<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background" />

    <!-- Top Left Glow -->
    <item android:top="-150dp" android:left="-150dp">
        <shape android:shape="oval">
            <size android:width="400dp" android:height="400dp" />
            <solid android:color="#4D00D2FF" /> <!-- 30% Cyan -->
        </shape>
    </item>

    <!-- Top Right Glow -->
    <item android:gravity="end|top" android:right="-80dp" android:top="40dp">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <solid android:color="#33FF00CC" /> <!-- 20% Pink -->
        </shape>
    </item>

    <!-- Center Left Glow -->
    <item android:gravity="start|center_vertical" android:left="-120dp">
        <shape android:shape="oval">
            <size android:width="350dp" android:height="350dp" />
            <solid android:color="#1A9D50BB" /> <!-- 10% Purple -->
        </shape>
    </item>

    <!-- Bottom Right Glow -->
    <item android:gravity="end|bottom" android:right="-100dp" android:bottom="-120dp">
        <shape android:shape="oval">
            <size android:width="380dp" android:height="380dp" />
            <solid android:color="#4000D2FF" /> <!-- 25% Cyan -->
        </shape>
    </item>
</layer-list>
