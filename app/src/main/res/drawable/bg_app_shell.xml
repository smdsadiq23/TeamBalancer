<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep midnight background -->
    <item android:drawable="@color/primary_dark" />

    <!-- Vibrant Mesh/Glow Gradients -->

    <!-- Top Left Cyan Glow -->
    <item android:top="-180dp" android:left="-180dp">
        <shape android:shape="oval">
            <size android:width="450dp" android:height="450dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="225dp"
                android:startColor="#6600D2FF"
                android:endColor="#0000D2FF" />
        </shape>
    </item>

    <!-- Top Right Hot Pink Glow -->
    <item android:gravity="end|top" android:right="-100dp" android:top="60dp">
        <shape android:shape="oval">
            <size android:width="350dp" android:height="350dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="175dp"
                android:startColor="#4DFF00CC"
                android:endColor="#00FF00CC" />
        </shape>
    </item>

    <!-- Center Left Purple Glow -->
    <item android:gravity="start|center_vertical" android:left="-140dp">
        <shape android:shape="oval">
            <size android:width="400dp" android:height="400dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:startColor="#339D50BB"
                android:endColor="#009D50BB" />
        </shape>
    </item>

    <!-- Bottom Right Electric Blue Glow -->
    <item android:gravity="end|bottom" android:right="-120dp" android:bottom="-140dp">
        <shape android:shape="oval">
            <size android:width="420dp" android:height="420dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:startColor="#5900F2FE"
                android:endColor="#0000F2FE" />
        </shape>
    </item>

    <!-- Subtle texture/grain overlay could be added here if needed -->
</layer-list>
