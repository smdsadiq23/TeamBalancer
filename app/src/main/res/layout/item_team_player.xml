<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stat_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/txtPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Player Name"
        android:textAppearance="@style/TextAppearance.TeamBalancer.TitleSmall"
        android:textColor="@color/on_surface" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkIsCaptain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="C"
        android:textAppearance="@style/TextAppearance.TeamBalancer.LabelMedium"
        android:textColor="@color/accent_cyan"
        android:visibility="gone"
        app:buttonTint="@color/accent_cyan" />

    <ImageButton
        android:id="@+id/btnMovePlayer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Move Player"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_move"
        app:tint="@color/on_surface_variant" />

</LinearLayout>
