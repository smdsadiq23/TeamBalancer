<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_dark"
    android:padding="16dp">

    <!-- Header Section -->
    <TextView
        android:id="@+id/txtMatchInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AUSSIES innings"
        android:textAppearance="@style/TextAppearance.TeamBalancer.TitleMedium"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txtLiveScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/txtLiveOvers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0.0 / 4)"
            android:layout_marginStart="12dp"
            android:textSize="20sp"
            android:textColor="@color/on_surface_variant"/>
    </LinearLayout>

    <!-- Player Stats Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏏 Batsmen"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtStriker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Striker ⭐"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/txtStrikerStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 (0)"
                android:textColor="@color/white"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/txtNonStriker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Non-Striker"
                android:textColor="@color/on_surface_variant"/>
            <TextView
                android:id="@+id/txtNonStrikerStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 (0)"
                android:textColor="@color/on_surface_variant"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Bowler"
            android:textColor="@color/accent_pink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtBowler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bowler"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/txtBowlerStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 - 0 - 0"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutScoringControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Scoring Controls -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:alignmentMode="alignBounds"
            android:layout_marginBottom="16dp">

            <Button android:id="@+id/btn0" android:text="0" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>
            <Button android:id="@+id/btn1" android:text="1" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>
            <Button android:id="@+id/btn2" android:text="2" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>
            <Button android:id="@+id/btn3" android:text="3" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>

            <Button android:id="@+id/btn4" android:text="4" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>
            <Button android:id="@+id/btn6" android:text="6" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>
            <Button android:id="@+id/btnWide" android:text="WD" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan" android:layout_columnWeight="1" android:textSize="18sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WKT"
                android:backgroundTint="@color/accent_pink"
                android:textColor="@color/white"
                app:cornerRadius="24dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"/>
        </GridLayout>

        <!-- Extra Extras Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <Button android:id="@+id/btnNB" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="NB" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan"/>
            <Button android:id="@+id/btnBye" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BYE" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan"/>
            <Button android:id="@+id/btnLB" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LB" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/accent_cyan"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNDO"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/accent_cyan"
            android:layout_centerVertical="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="FINISH MATCH"
            android:backgroundTint="@color/accent_cyan"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            app:cornerRadius="30dp"
            android:layout_marginStart="100dp"/>
    </RelativeLayout>

</LinearLayout>
