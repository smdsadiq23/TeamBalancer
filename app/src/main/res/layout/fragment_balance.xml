<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_shell">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.TeamBalancer.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Balance Teams"
            app:titleCentered="true" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_x"
            android:paddingTop="8dp"
            android:paddingBottom="@dimen/content_bottom_inset">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/glass_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stat_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="LIVE BALANCER"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCurrentClub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Current Club: B Cube"
                        android:textAppearance="@style/TextAppearance.TeamBalancer.TitleLarge"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/txtAvailableCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Available Players: 0"
                        android:textAppearance="@style/TextAppearance.TeamBalancer.BodySmall"
                        android:textColor="@color/on_surface_variant" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Select Sport">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerSport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:text="Cricket"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtSavedTeamsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/saved_teams_label"
                        android:visibility="gone"
                        android:textAppearance="@style/TextAppearance.TeamBalancer.LabelSmall"
                        android:textColor="@color/on_surface_variant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTeams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:chipSpacingHorizontal="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutTeamNames"
                        style="@style/Widget.TeamBalancer.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Team Names"
                        app:boxBackgroundColor="@color/surface_elevated"
                        app:boxStrokeColor="@color/accent"
                        app:hintTextColor="@color/accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTeamNames"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:paddingVertical="10dp"
                            android:textColor="@color/on_surface"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutSearch"
                        style="@style/Widget.TeamBalancer.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Search Players"
                        app:boxBackgroundColor="@color/surface_elevated"
                        app:boxStrokeColor="@color/accent"
                        app:hintTextColor="@color/accent"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:startIconTint="@color/on_surface_variant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:paddingVertical="10dp"
                            android:textColor="@color/on_surface"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="CAPTAINS AND SEARCH"
                        android:textAppearance="@style/TextAppearance.TeamBalancer.LabelSmall"
                        android:textColor="@color/on_surface_variant" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCaptainSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerate"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cta_height"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_button_gradient"
                        android:text="GENERATE TEAMS"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/card_corner_lg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
