<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_shell">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.TeamBalancer.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Manage Players"
            app:titleCentered="true" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/screen_padding_x"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/content_bottom_inset"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/glass_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stat_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="ACTIVE CLUB"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Select Club"
                        app:boxBackgroundColor="@color/surface_elevated"
                        app:boxStrokeColor="@color/accent"
                        app:hintTextColor="@color/accent"
                        app:startIconDrawable="@drawable/ic_clubs"
                        app:startIconTint="@color/on_surface_variant">

                        <AutoCompleteTextView
                            android:id="@+id/editClubName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:paddingVertical="14dp"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/glass_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_surface_panel"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADD NEW PLAYER"
                        android:textAppearance="@style/TextAppearance.TeamBalancer.LabelLarge"
                        android:textColor="@color/on_surface_variant" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.TeamBalancer.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Name"
                        app:boxBackgroundColor="@color/surface_elevated"
                        app:boxStrokeColor="@color/accent"
                        app:hintTextColor="@color/accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPlayerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="@color/on_surface"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Style"
                            app:boxBackgroundColor="@color/surface_elevated"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Category"
                            app:boxBackgroundColor="@color/surface_elevated"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Batting"
                            app:boxBackgroundColor="@color/surface_elevated"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteBatting"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Bowling"
                            app:boxBackgroundColor="@color/surface_elevated"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteBowling"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.TeamBalancer.TextInputLayout.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Fielding"
                            app:boxBackgroundColor="@color/surface_elevated"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteFielding"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkIsCaptain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mark as Captain"
                        android:textColor="@color/on_surface_variant"
                        app:buttonTint="@color/accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cta_height"
                        android:layout_marginTop="14dp"
                        android:letterSpacing="0.05"
                        android:text="ADD PLAYER"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="@dimen/card_corner_lg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPlayerListHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CLUB PLAYERS"
                    android:textAppearance="@style/TextAppearance.TeamBalancer.LabelLarge"
                    android:textColor="@color/ch_text_primary" />

                <TextView
                    android:id="@+id/txtPlayerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 0"
                    android:textAppearance="@style/TextAppearance.TeamBalancer.TitleMedium"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPlayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
