<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="152dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_surface_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtTeamName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Team 1"
        android:textAppearance="@style/TextAppearance.TeamBalancer.TitleMedium"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/txtTeamStrength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Str: 100"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/txtTeamPlayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="Player 1\nPlayer 2"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/on_surface" />

</LinearLayout>
