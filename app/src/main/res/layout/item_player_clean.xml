<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/playerRowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkAvailable"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:checked="true"
            app:buttonTint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player Name"
                android:textAppearance="@style/TextAppearance.TeamBalancer.TitleLarge"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/txtPlayerStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Style"
                android:textAppearance="@style/TextAppearance.TeamBalancer.BodyMedium"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAssignedTeam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_stat_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Assign Team"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkIsCaptain"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_stat_pill"
            android:button="@null"
            android:gravity="center"
            android:text="C"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold"
            app:buttonTint="@color/accent" />

        <ImageButton
            android:id="@+id/btnInfoPlayer"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_info"
            app:tint="@color/on_surface_variant" />

        <ImageButton
            android:id="@+id/btnDeletePlayer"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="@color/accent" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
