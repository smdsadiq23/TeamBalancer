<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet / large: two-column scoreboard + squads at bottom (no inner tabs). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scorecard_batting"
                android:textAppearance="@style/TextAppearance.TeamBalancer.TitleSmall"
                android:textColor="@color/accent_cyan" />

            <TextView
                android:id="@+id/txtFullScoreboardBatting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.2"
                android:text="—"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/scorecard_bowling"
                android:textAppearance="@style/TextAppearance.TeamBalancer.TitleSmall"
                android:textColor="@color/accent_pink" />

            <TextView
                android:id="@+id/txtFullScoreboardBowling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.2"
                android:text="—"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scorecard_extras"
                android:textAppearance="@style/TextAppearance.TeamBalancer.TitleSmall"
                android:textColor="@color/warning" />

            <TextView
                android:id="@+id/txtFullScoreboardExtras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Wd:0 Nb:0 B:0 Lb:0"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/scorecard_timeline"
                android:textAppearance="@style/TextAppearance.TeamBalancer.TitleSmall"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/txtFullScoreboardTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.15"
                android:text="—"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:background="#33FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scorecard_squads"
        android:textAppearance="@style/TextAppearance.TeamBalancer.TitleSmall"
        android:textColor="@color/accent_purple" />

    <TextView
        android:id="@+id/txtFullScoreboardSquads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="—"
        android:textColor="@color/on_surface_secondary"
        android:textSize="13sp" />
</LinearLayout>
