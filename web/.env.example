# PostgreSQL connection (SSL params optional, e.g. ?sslmode=require for managed DBs).
# Default Docker-style:
#   postgresql://postgres:PASSWORD@localhost:5432/teambalancer?schema=public
# macOS/Homebrew (no "postgres" role): use your OS username, often no password:
#   postgresql://YOUR_MAC_USERNAME@localhost:5432/teambalancer?schema=public
# Min 32 chars; used to sign session JWT
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Next.js: `npm run dev` uses host 0.0.0.0 and port 3010 (reachable from LAN / tablets).
# `npm run start` uses host 0.0.0.0 and port 8020 after build.
